//// [tests/cases/conformance/classes/nestedClassDeclaration.ts] ////

=== nestedClassDeclaration.ts ===
// nested classes are not allowed

class C {
>C : C

    x: string;
>x : string

    class C2 {
>C2 : C2
    }
}

function foo() {
>foo : () => void

    class C3 {
>C3 : C3
    }
}

var x = {
>x : { class: C4; }
>{    class C4 {    }} : { class: C4; }

    class C4 {
>class : C4
>C4 {    } : C4
    }
}

