=== kvsSwitch.ts ===
declare function calculate(): number;
>calculate : () => number

declare function readCache(): string | null;
>readCache : () => string | null

declare function audit(value: string): void;
>audit : (value: string) => void
>value : string

declare const count: number;
>count : number

declare const choice: boolean;
>choice : boolean

declare const maybeText: string | null;
>maybeText : string | null

const word = switch (count) {
>word : "few" | "many" | "one"
>switch (count) {    case 1: "one";    case 2 | 3: "few";    default: "many";} : "few" | "many" | "one"
>count : number

    case 1: "one";
>1 : 1
>"one" : "one"

    case 2 | 3: "few";
>2 | 3 : number
>2 : 2
>3 : 3
>"few" : "few"

    default: "many";
>"many" : "many"

};

const shipping = switch {
>shipping : 0 | 5 | 12
>switch {    case word == "one": 0;    case word == "few": 5;    default: 12;} : 0 | 5 | 12

    case word == "one": 0;
>word == "one" : boolean
>word : "few" | "many" | "one"
>"one" : "one"
>0 : 0

    case word == "few": 5;
>word == "few" : boolean
>word : "few" | "many" | "one"
>"few" : "few"
>5 : 5

    default: 12;
>12 : 12

};

const description = switch (const n = calculate()) {
>description : "large" | "negative" | "small" | "zero"
>switch (const n = calculate()) {    case n < 0: "negative";    case n == 0: "zero";    case n < 10: "small";    default: "large";} : "large" | "negative" | "small" | "zero"
>n : number
>calculate() : number
>calculate : () => number

    case n < 0: "negative";
>n < 0 : boolean
>n : number
>0 : 0
>"negative" : "negative"

    case n == 0: "zero";
>n == 0 : boolean
>n : number
>0 : 0
>"zero" : "zero"

    case n < 10: "small";
>n < 10 : boolean
>n : number
>10 : 10
>"small" : "small"

    default: "large";
>"large" : "large"

};

const cached = switch ("cache") {
>cached : string
>switch ("cache") {    case "cache": {        yield? readCache();        audit("miss");        yield "fallback";    }    default: "fallback";} : string
>"cache" : "cache"

    case "cache": {
>"cache" : "cache"

        yield? readCache();
>readCache() : string | null
>readCache : () => string | null

        audit("miss");
>audit("miss") : void
>audit : (value: string) => void
>"miss" : "miss"

        yield "fallback";
>"fallback" : "fallback"
    }
    default: "fallback";
>"fallback" : "fallback"

};

const conditionalYield = switch {
>conditionalYield : "other" | "positive"
>switch {    case count > 0: {        yield "positive";        audit("unreachable");    }    default: "other";} : "other" | "positive"

    case count > 0: {
>count > 0 : boolean
>count : number
>0 : 0

        yield "positive";
>"positive" : "positive"

        audit("unreachable");
>audit("unreachable") : void
>audit : (value: string) => void
>"unreachable" : "unreachable"
    }
    default: "other";
>"other" : "other"

};

const nestedYield = switch (count) {
>nestedYield : string
>switch (count) {    case 1: {        for (const value of ["one"]) {            yield value;        }        yield "fallback";    }    default: "other";} : string
>count : number

    case 1: {
>1 : 1

        for (const value of ["one"]) {
>value : string
>["one"] : string[]
>"one" : "one"

            yield value;
>value : string
        }
        yield "fallback";
>"fallback" : "fallback"
    }
    default: "other";
>"other" : "other"

};

const exhaustiveProcedural = switch (count) {
>exhaustiveProcedural : "chosen" | "other"
>switch (count) {    case 1: {        if (choice) {            yield "chosen";        } else {            yield "other";        }    }    default: {        throw new Error("unsupported count");    }} : "chosen" | "other"
>count : number

    case 1: {
>1 : 1

        if (choice) {
>choice : boolean

            yield "chosen";
>"chosen" : "chosen"

        } else {
            yield "other";
>"other" : "other"
        }
    }
    default: {
        throw new Error("unsupported count");
>new Error("unsupported count") : Error
>Error : ErrorConstructor
>"unsupported count" : "unsupported count"
    }
};

const completingProcedural = switch {
>completingProcedural : "other" | "positive" | null
>switch {    case choice: {        if (count > 0) {            yield "positive";        }    }    default: "other";} : "other" | "positive" | null

    case choice: {
>choice : boolean

        if (count > 0) {
>count > 0 : boolean
>count : 1
>0 : 0

            yield "positive";
>"positive" : "positive"
        }
    }
    default: "other";
>"other" : "other"

};

const extantProcedural = switch {
>extantProcedural : string | null
>switch {    case choice: {        yield? maybeText;    }    default: "other";} : string | null

    case choice: {
>choice : boolean

        yield? maybeText;
>maybeText : string | null
    }
    default: "other";
>"other" : "other"

};

const groupedBitwise = switch (3) {
>groupedBitwise : boolean
>switch (3) {    case (1 | 2): true;    default: false;} : boolean
>3 : 3

    case (1 | 2): true;
>(1 | 2) : number
>1 | 2 : number
>1 : 1
>2 : 2
>true : true

    default: false;
>false : false

};

const nested = switch (count) {
>nested : "other" | "positive"
>switch (count) {    case 1: switch {        case count > 0: "positive";        default: "other";    };    default: "other";} : "other" | "positive"
>count : 1

    case 1: switch {
>1 : 1
>switch {        case count > 0: "positive";        default: "other";    } : "other" | "positive"

        case count > 0: "positive";
>count > 0 : boolean
>count : 1
>0 : 0
>"positive" : "positive"

        default: "other";
>"other" : "other"

    };
    default: "other";
>"other" : "other"

};

const collectedThroughClassic = collect ([1, 2]) {
>collectedThroughClassic : ("one" | "other")[]
>collect ([1, 2]) {    switch (_) {        case 1:            yield "one";            break;        default:            yield "other";            break;    }} : ("one" | "other")[]
>[1, 2] : number[]
>1 : 1
>2 : 2

    switch (_) {
>_ : number

        case 1:
>1 : 1

            yield "one";
>"one" : "one"

            break;
        default:
            yield "other";
>"other" : "other"

            break;
    }
};

function returnFromArm(value: number) {
>returnFromArm : (value: number) => string
>value : number

    switch (value) {
>switch (value) {        case 1: {            return "returned";        }        default: "continued";    } : "continued"
>value : number

        case 1: {
>1 : 1

            return "returned";
>"returned" : "returned"
        }
        default: "continued";
>"continued" : "continued"

    };
    return "after";
>"after" : "after"
}

function allArmsExit(value: number): string {
>allArmsExit : (value: number) => string
>value : number

    return switch (value) {
>switch (value) {        case 1: {            return "returned";        }        default: {            throw new Error("unsupported value");        }    } : never
>value : number

        case 1: {
>1 : 1

            return "returned";
>"returned" : "returned"
        }
        default: {
            throw new Error("unsupported value");
>new Error("unsupported value") : Error
>Error : ErrorConstructor
>"unsupported value" : "unsupported value"
        }
    };
}

function bareReturnIsClassic(value: number) {
>bareReturnIsClassic : (value: number) => "one" | "other"
>value : number

    switch (value) {
>value : number

        case 1: return "one";
>1 : 1
>"one" : "one"

        default: return "other";
>"other" : "other"
    }
}

function classic(kind: number) {
>classic : (kind: number) => void
>kind : number

    switch (kind) {
>kind : number

        case 1:
>1 : 1

            audit("one");
>audit("one") : void
>audit : (value: string) => void
>"one" : "one"

            break;
        case 2:
>2 : 2

            audit("two");
>audit("two") : void
>audit : (value: string) => void
>"two" : "two"

            break;
    }
}

